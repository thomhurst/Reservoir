<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(ReservoirTargetFramework)' == 'netstandard2.0'">$(DefineConstants);RESERVOIR_NETSTANDARD</DefineConstants>
    <EnableDefaultCompileItems Condition="'$(ReservoirTargetFramework)' == 'netstandard2.0'">false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reservoir\Reservoir.csproj"
                      Condition="'$(ReservoirTargetFramework)' == ''" />
    <ProjectReference Include="..\..\src\Reservoir\Reservoir.csproj"
                      Condition="'$(ReservoirTargetFramework)' != ''"
                      AdditionalProperties="TargetFramework=$(ReservoirTargetFramework)"
                      ReferenceOutputAssembly="false" />
    <!-- A file reference preserves the selected asset in BenchmarkDotNet's transitive host.
         A project reference alone lets NuGet select the host's nearest modern asset again. -->
    <Reference Include="Reservoir" Condition="'$(ReservoirTargetFramework)' != ''">
      <HintPath>../../src/Reservoir/bin/$(Configuration)/$(ReservoirTargetFramework)/Reservoir.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- A bounded portable suite measures destruction and the affected runtime/factory paths. -->
  <ItemGroup Condition="'$(ReservoirTargetFramework)' == 'netstandard2.0'">
    <Compile Include="Program.cs;DestroyPolicyBenchmarks.cs;RuntimeObjectPoolBenchmarks.cs" />
  </ItemGroup>
</Project>
