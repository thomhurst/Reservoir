<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Reservoir</PackageId>
    <Title>Reservoir</Title>
    <Authors>Tom Longhurst</Authors>
    <Company>Tom Longhurst</Company>
    <Copyright>Copyright © Tom Longhurst</Copyright>
    <Description>High-performance, allocation-conscious object pools for .NET.</Description>
    <PackageTags>object-pool;object-pooling;pooling;performance;allocation-free;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/thomhurst/Reservoir</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thomhurst/Reservoir.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Reservoir.Benchmarks" />
    <InternalsVisibleTo Include="Reservoir.NetStandard.Tests" />
    <InternalsVisibleTo Include="Reservoir.Tests" />
  </ItemGroup>
</Project>
